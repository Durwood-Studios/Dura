# Supabase — public keys only (safe for client-side)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER add SUPABASE_SERVICE_ROLE_KEY to this project.
# RLS policies protect the data. See CLAUDE.md Rule 4.

# Admin dashboard — hidden by default. Set to "true" to enable /admin.
# NEXT_PUBLIC_ADMIN_ENABLED=true

# Server-only secret for the HMAC-SHA-256 verification signature layer.
# When set (≥ 32 chars), /api/verify/sign issues signatures and
# /api/verify/check validates them. Newly earned certificates get a
# math-anchored badge resolvable from any device via the shared URL's
# ?sig= query param. Without this secret the cert flow still works, the
# signing endpoints return 503, and the math badge does not appear.
# Generate with: openssl rand -hex 32
# VERIFICATION_HMAC_SECRET=
