{
  "name": "dura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-source-copies.mjs && node scripts/build-lab-bundles.mjs && next build --webpack && node scripts/build-offline-manifest.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:standards": "vitest run tests/standards",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:claude-md": "node scripts/check-claude-md-sections.mjs",
    "check:ai-provenance": "node scripts/check-ai-provenance.mjs",
    "check:analytics-catalog": "node scripts/check-analytics-catalog.mjs",
    "check:lflrs-schema": "node scripts/check-lflrs-schema.mjs",
    "check:standards-alignment": "node scripts/check-standards-alignment.mjs",
    "check:standards": "npm run check:claude-md && npm run check:lflrs-schema && npm run check:analytics-catalog && npm run check:ai-provenance && npm run check:standards-alignment",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.102.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lenis": "^1.3.21",
    "lucide-react": "^1.7.0",
    "motion": "^12.39.0",
    "next": "^16.3.5",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.12",
    "shiki": "^4.0.2",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.8.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "browserslist": "^4.28.7"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
